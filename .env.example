# Where the page loads orbital data from (OMM JSON). Default: CelesTrak.
# Fallback path: ./data/orbits.json
VITE_ORBITS_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=active&FORMAT=json
# Visit counter endpoint. Empty = counting off.
VITE_COUNTER_URL=
# goatcounter | umami
VITE_COUNTER_KIND=goatcounter
